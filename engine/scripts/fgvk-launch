#!/usr/bin/env bash
# Launch one command with the standalone framegen-vulkan Vulkan layer enabled.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: fgvk [--] COMMAND [ARG ...]

Activates framegen-vulkan for one command through its supported SDR presentation
boundary, prevents the known LSFG-VK 1.x and 2.x frame-generation layers from
joining the same Vulkan process, and uses a deterministic framegen-vulkan implicit-layer
directory for reliable swapchain ownership.

Set environment variables before fgvk to pass them to the game:
  FGVK_PROFILE=my-profile fgvk COMMAND [ARG ...]

Enable installed host MangoHud (requires Python 3):
  MANGOHUD=1 fgvk COMMAND [ARG ...]

Standalone launch compatibility settings are read from:
  ~/.config/framegen-vulkan/launcher.conf

FGVK_LAUNCH_CONFIG=/path/to/launcher.conf selects another settings file.

Advanced troubleshooting only:
  FGVK_ALLOW_COMPETING_LAYERS=1 fgvk COMMAND [ARG ...]

Allowing multiple frame-generation layers in one process is unsupported and
may cause startup, synchronization, presentation, or image-quality failures.
EOF
}

# Only named, guarded manifests enter the private directory; never
# expose the host's implicit-layer directory to the game. Python runs only when
# MangoHud is requested, not on normal launches or in the rendering loop.
fgvk_mangohud_manifests() {
    python3 - <<'PYTHON'
import contextlib
import fcntl
import json
import os
from pathlib import Path
import platform
import stat
import sys
import tempfile


def discover():
    if os.environ.get("FLATPAK_ID") or platform.machine() not in ("x86_64", "AMD64"):
        return {}
    home = Path.home()
    roots = [Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config"),
             Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share")]
    for key, default in (("XDG_CONFIG_DIRS", "/etc/xdg"), ("XDG_DATA_DIRS", "/usr/local/share:/usr/share")):
        roots.extend(Path(value) for value in (os.environ.get(key) or default).split(":") if value.startswith("/"))
    admitted = {}
    for suffix, arch in (("x86_64", "64"), ("x86", "32")):
        filename = "MangoHud." + suffix + ".json"
        for root in roots:
            if not root.is_absolute():
                continue
            source = root / "vulkan/implicit_layer.d" / filename
            try:
                # Nonblocking open plus fstat prevents special files from hanging
                # a game launch.
                fd = os.open(source, os.O_RDONLY | os.O_NONBLOCK)
                with os.fdopen(fd, "rb") as stream:
                    if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                        continue
                    content = stream.read(65537)
                if len(content) > 65536:
                    continue
                manifest = json.loads(content)
                layer = manifest.get("layer")
                if (not isinstance(layer, dict) or "layers" in manifest or
                        layer.get("name") != "VK_LAYER_MANGOHUD_overlay_" + suffix or
                        layer.get("type") != "GLOBAL" or
                        layer.get("library_arch") not in (None, arch) or
                        layer.get("enable_environment") != {"MANGOHUD": "1"} or
                        layer.get("disable_environment") != {"DISABLE_MANGOHUD": "1"}):
                    continue
                library = layer.get("library_path")
                if not isinstance(library, str) or not library or any(c in library for c in "\r\n\0"):
                    continue
                if "/" in library:
                    library_path = (source.parent / library).resolve()
                    if not library_path.is_file() or not os.access(library_path, os.R_OK):
                        continue
                    layer["library_path"] = str(library_path)
                layer["library_arch"] = arch
                admitted[filename] = json.dumps(manifest, indent=2) + "\n"
                break
            except (OSError, ValueError, AttributeError, TypeError):
                continue
    return admitted


@contextlib.contextmanager
def locked_directory(directory):
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield os.fstat(fd)
    finally:
        os.close(fd)


def prepare(manifests):
    if not manifests:
        raise ValueError("no compatible host MangoHud manifest")
    directory = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "framegen-vulkan/mangohud"
    if not directory.is_absolute() or any(c in str(directory) for c in ":\r\n"):
        raise ValueError("invalid MangoHud cache path")
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Concurrent launches must not observe another launch's temporary file.
    with locked_directory(directory) as info:
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
            raise ValueError("MangoHud cache directory is not private")
        names = {"MangoHud.x86_64.json", "MangoHud.x86.json"}
        if any(path.name not in names for path in directory.iterdir()):
            raise ValueError("unexpected files in MangoHud cache directory")
        for name in names:
            target = directory / name
            if target.is_symlink() or (target.exists() and not target.is_file()):
                raise ValueError("invalid cached MangoHud manifest")
            if name not in manifests:
                target.unlink(missing_ok=True)
                continue
            content = manifests[name]
            if (target.exists() and target.stat().st_size == len(content.encode()) and
                    target.read_bytes() == content.encode()):
                continue
            fd, temporary = tempfile.mkstemp(prefix="mangohud-manifest-", dir=directory.parent)
            try:
                with os.fdopen(fd, "w") as stream:
                    stream.write(content)
                os.replace(temporary, target)
            finally:
                Path(temporary).unlink(missing_ok=True)
    return directory


try:
    print(prepare(discover()))
except (OSError, ValueError) as error:
    print("framegen-vulkan: MangoHud unavailable: " + str(error), file=sys.stderr)
    sys.exit(1)
PYTHON
}

if (($# == 0)); then
    echo "fgvk-launch requires a command to run." >&2
    usage >&2
    exit 2
fi

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
    --)
        shift
        if (($# == 0)); then
            echo "fgvk-launch requires a command after --." >&2
            usage >&2
            exit 2
        fi
        ;;
esac

# Gamescope sessions run frame generation by default; FGVK_GAMESCOPE=0 opts out.
# Decide before any environment change so the command starts with its environment
# exactly as launched. The renderer makes its own check and stays inactive
# under the same opt-out.
if [[ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" &&
        ( -z "${WAYLAND_DISPLAY:-}" ||
          "${WAYLAND_DISPLAY}" == "${GAMESCOPE_WAYLAND_DISPLAY}" ) &&
        "${FGVK_GAMESCOPE:-}" == "0" ]]; then
    echo "framegen-vulkan: Gamescope session: starting without frame generation (FGVK_GAMESCOPE=0)" >&2
    exec "$@"
fi

# Launcher-only compatibility settings must be established before the child
# starts, but they are not Renderer profile values and must never be placed in
# conf.toml. Parse the fixed key/value format without sourcing or
# evaluating user-controlled text. An invalid file fails closed to defaults.
fgvk_launch_config_path="${FGVK_LAUNCH_CONFIG:-}"
if [[ -z "$fgvk_launch_config_path" ]]; then
    if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
        fgvk_launch_config_path="$XDG_CONFIG_HOME/framegen-vulkan/launcher.conf"
    elif [[ -n "${HOME:-}" ]]; then
        fgvk_launch_config_path="$HOME/.config/framegen-vulkan/launcher.conf"
    else
        fgvk_launch_config_path="/etc/framegen-vulkan/launcher.conf"
    fi
fi
unset FGVK_LAUNCH_CONFIG

fgvk_launch_version_seen=0
fgvk_disable_hdr_exposure_seen=0
fgvk_disable_steam_overlay=1
fgvk_disable_steam_overlay_seen=0
fgvk_launch_enable_zink=0
fgvk_launch_force_alsa_audio=0
fgvk_launch_enable_zink_seen=0
fgvk_launch_force_alsa_audio_seen=0
fgvk_launch_log_pacing=0
fgvk_launch_log_trace=0
fgvk_launch_log_wayland=0
fgvk_launch_log_gpu_cost=0
fgvk_launch_log_pacing_seen=0
fgvk_launch_log_trace_seen=0
fgvk_launch_log_wayland_seen=0
fgvk_launch_log_gpu_cost_seen=0
fgvk_launch_log_present_seen=0
fgvk_launch_config_valid=1
if [[ -f "$fgvk_launch_config_path" ]]; then
    while IFS= read -r fgvk_launch_line || [[ -n "$fgvk_launch_line" ]]; do
        fgvk_launch_line="${fgvk_launch_line#"${fgvk_launch_line%%[!$' \t\r\n']*}"}"
        fgvk_launch_line="${fgvk_launch_line%"${fgvk_launch_line##*[!$' \t\r\n']}"}"
        if [[ -z "$fgvk_launch_line" || "$fgvk_launch_line" == \#* ]]; then
            continue
        fi
        if [[ "$fgvk_launch_line" != *=* ]]; then
            fgvk_launch_config_valid=0
            break
        fi
        fgvk_launch_key="${fgvk_launch_line%%=*}"
        fgvk_launch_value="${fgvk_launch_line#*=}"
        if [[ "$fgvk_launch_value" == *=* ]]; then
            fgvk_launch_config_valid=0
            break
        fi
        fgvk_launch_key="${fgvk_launch_key#"${fgvk_launch_key%%[!$' \t\r\n']*}"}"
        fgvk_launch_key="${fgvk_launch_key%"${fgvk_launch_key##*[!$' \t\r\n']}"}"
        fgvk_launch_value="${fgvk_launch_value#"${fgvk_launch_value%%[!$' \t\r\n']*}"}"
        fgvk_launch_value="${fgvk_launch_value%"${fgvk_launch_value##*[!$' \t\r\n']}"}"
        case "$fgvk_launch_key" in
            version)
                if [[ "$fgvk_launch_version_seen" != 0 || "$fgvk_launch_value" != 1 ]]; then
                    fgvk_launch_config_valid=0
                    break
                fi
                fgvk_launch_version_seen=1
                ;;
            disable_hdr_exposure)
                if [[ "$fgvk_disable_hdr_exposure_seen" != 0 ||
                        "$fgvk_launch_value" != 0 && "$fgvk_launch_value" != 1 ]]; then
                    fgvk_launch_config_valid=0
                    break
                fi
                fgvk_disable_hdr_exposure_seen=1
                ;;
            disable_steam_overlay)
                if [[ "$fgvk_disable_steam_overlay_seen" != 0 ||
                        "$fgvk_launch_value" != 0 && "$fgvk_launch_value" != 1 ]]; then
                    fgvk_launch_config_valid=0
                    break
                fi
                fgvk_disable_steam_overlay="$fgvk_launch_value"
                fgvk_disable_steam_overlay_seen=1
                ;;
            enable_zink)
                if [[ "$fgvk_launch_enable_zink_seen" != 0 ||
                        "$fgvk_launch_value" != 0 && "$fgvk_launch_value" != 1 ]]; then
                    fgvk_launch_config_valid=0
                    break
                fi
                fgvk_launch_enable_zink="$fgvk_launch_value"
                fgvk_launch_enable_zink_seen=1
                ;;
            force_alsa_audio)
                if [[ "$fgvk_launch_force_alsa_audio_seen" != 0 ||
                        "$fgvk_launch_value" != 0 && "$fgvk_launch_value" != 1 ]]; then
                    fgvk_launch_config_valid=0
                    break
                fi
                fgvk_launch_force_alsa_audio="$fgvk_launch_value"
                fgvk_launch_force_alsa_audio_seen=1
                ;;
            log_pacing)
                if [[ "$fgvk_launch_log_pacing_seen" != 0 ||
                        "$fgvk_launch_value" != 0 && "$fgvk_launch_value" != 1 ]]; then
                    fgvk_launch_config_valid=0
                    break
                fi
                fgvk_launch_log_pacing="$fgvk_launch_value"
                fgvk_launch_log_pacing_seen=1
                ;;
            log_trace)
                if [[ "$fgvk_launch_log_trace_seen" != 0 ||
                        "$fgvk_launch_value" != 0 && "$fgvk_launch_value" != 1 ]]; then
                    fgvk_launch_config_valid=0
                    break
                fi
                fgvk_launch_log_trace="$fgvk_launch_value"
                fgvk_launch_log_trace_seen=1
                ;;
            log_wayland)
                if [[ "$fgvk_launch_log_wayland_seen" != 0 ||
                        "$fgvk_launch_value" != 0 && "$fgvk_launch_value" != 1 ]]; then
                    fgvk_launch_config_valid=0
                    break
                fi
                fgvk_launch_log_wayland="$fgvk_launch_value"
                fgvk_launch_log_wayland_seen=1
                ;;
            log_gpu_cost)
                if [[ "$fgvk_launch_log_gpu_cost_seen" != 0 ||
                        "$fgvk_launch_value" != 0 && "$fgvk_launch_value" != 1 ]]; then
                    fgvk_launch_config_valid=0
                    break
                fi
                fgvk_launch_log_gpu_cost="$fgvk_launch_value"
                fgvk_launch_log_gpu_cost_seen=1
                ;;
            log_present)
                # Retired: the renderer has no present diagnostics switch. Old files stay valid and the value is ignored.
                if [[ "$fgvk_launch_log_present_seen" != 0 ||
                        "$fgvk_launch_value" != 0 && "$fgvk_launch_value" != 1 ]]; then
                    fgvk_launch_config_valid=0
                    break
                fi
                fgvk_launch_log_present_seen=1
                ;;
            *)
                fgvk_launch_config_valid=0
                break
                ;;
        esac
    done < "$fgvk_launch_config_path"

    if [[ "$fgvk_launch_version_seen" != 1 ]]; then
        fgvk_launch_config_valid=0
    fi
    if [[ "$fgvk_launch_config_valid" != 1 ]]; then
        echo "fgvk-launch: ignoring invalid launcher configuration: $fgvk_launch_config_path" >&2
        fgvk_launch_enable_zink=0
        fgvk_launch_force_alsa_audio=0
        fgvk_disable_steam_overlay=1
        fgvk_launch_log_pacing=0
        fgvk_launch_log_trace=0
        fgvk_launch_log_wayland=0
        fgvk_launch_log_gpu_cost=0
    fi
fi
unset fgvk_launch_config_path fgvk_launch_line fgvk_launch_key fgvk_launch_value
unset fgvk_launch_version_seen fgvk_launch_config_valid
unset fgvk_launch_enable_zink_seen fgvk_launch_force_alsa_audio_seen
unset fgvk_launch_log_pacing_seen fgvk_launch_log_trace_seen fgvk_launch_log_wayland_seen
unset fgvk_launch_log_gpu_cost_seen fgvk_launch_log_present_seen
unset fgvk_disable_steam_overlay_seen
unset fgvk_disable_hdr_exposure_seen

if [[ "$fgvk_launch_enable_zink" == 1 ]]; then
    export __GLX_VENDOR_LIBRARY_NAME=mesa
    export MESA_LOADER_DRIVER_OVERRIDE=zink
    export GALLIUM_DRIVER=zink
fi
if [[ "$fgvk_launch_force_alsa_audio" == 1 ]]; then
    export SDL_AUDIODRIVER=alsa
    case ";${WINEDLLOVERRIDES:-};" in
        *";winepulse.drv=d;"*) ;;
        *) export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}winepulse.drv=d" ;;
    esac
    case ";${WINEDLLOVERRIDES:-};" in
        *";winealsa.drv=b;"*) ;;
        *) export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}winealsa.drv=b" ;;
    esac
fi
unset fgvk_launch_enable_zink fgvk_launch_force_alsa_audio

# Logging switches from launcher.conf export the renderer's diagnostic variables
# as 1. A variable the caller already set, including an explicit 0, always wins,
# and nothing is exported when framegen-vulkan is disabled. FGVK_PACING_PROFILE=1
# is also required by GPU split timing, so either pacing or GPU cost exports it.
if [[ "${DISABLE_FGVK:-0}" != 1 ]]; then
    if [[ "$fgvk_launch_log_pacing" == 1 || "$fgvk_launch_log_gpu_cost" == 1 ]] &&
            [[ -z "${FGVK_PACING_PROFILE+x}" ]]; then
        export FGVK_PACING_PROFILE=1
    fi
    if [[ "$fgvk_launch_log_trace" == 1 && -z "${FGVK_PACING_PROFILE_TRACE+x}" ]]; then
        export FGVK_PACING_PROFILE_TRACE=1
    fi
    if [[ "$fgvk_launch_log_wayland" == 1 && -z "${FGVK_PACING_PROFILE_WAYLAND+x}" ]]; then
        export FGVK_PACING_PROFILE_WAYLAND=1
    fi
    if [[ "$fgvk_launch_log_gpu_cost" == 1 && -z "${FGVK_PACING_PROFILE_GPU_SPLIT+x}" ]]; then
        export FGVK_PACING_PROFILE_GPU_SPLIT=1
    fi
fi
unset fgvk_launch_log_pacing fgvk_launch_log_trace fgvk_launch_log_wayland
unset fgvk_launch_log_gpu_cost

# vkBasalt is no longer bundled. An ENABLE_VKBASALT request is ignored with one
# notice. The variables are removed here, and DISABLE_VKBASALT=1 keeps any
# foreign or system vkBasalt layer inactive in every launch.
if [[ "${ENABLE_VKBASALT:-0}" != 0 ]]; then
    echo "fgvk-launch: vkBasalt is no longer bundled; ENABLE_VKBASALT ignored." >&2
fi
fgvk_mangohud_requested="${MANGOHUD:-0}"
case "$fgvk_mangohud_requested" in
    0|1) ;;
    *) echo "framegen-vulkan: MANGOHUD must be 0 or 1." >&2; exit 2 ;;
esac
unset MANGOHUD
export DISABLE_MANGOHUD=1
unset ENABLE_VKBASALT VKBASALT_CONFIG_FILE VKBASALT_CONFIG_RELOAD
export DISABLE_VKBASALT=1

allow_competing_layers="${FGVK_ALLOW_COMPETING_LAYERS:-0}"
case "$allow_competing_layers" in
    0)
        # These are the disable_environment gates declared by the two public
        # LSFG-VK manifest generations. The Vulkan loader must see them before
        # it discovers and assembles the process's layer chain.
        export DISABLE_LSFG=1
        export DISABLE_LSFGVK=1
        ;;
    1)
        # Explicitly remove inherited guards for an advanced comparison run.
        # This is intentionally opt-in and unsupported for ordinary gameplay.
        unset DISABLE_LSFG DISABLE_LSFGVK
        ;;
    *)
        echo "FGVK_ALLOW_COMPETING_LAYERS must be 0 or 1." >&2
        exit 2
        ;;
esac

# Do not expose the launcher's private policy switch to the renderer or game.
unset FGVK_ALLOW_COMPETING_LAYERS

# Resolve the installed private manifest directory from this launcher. This is
# the deterministic SDR boundary proven by framegen-vulkan v2: Steam's Vulkan Fossilize,
# overlay, and system-wide presentation layers cannot bypass framegen-vulkan's device or
# swapchain hooks. Steam's Game Mode UI remains outside this application layer
# chain. Older packages fall back to their public manifest.
# This helper lives at <prefix>/libexec/framegen-vulkan/fgvk-launch, so the
# prefix is two directories above it.
fgvk_launcher_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
fgvk_install_prefix="$(cd -- "$fgvk_launcher_dir/../.." && pwd -P)"
fgvk_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
fgvk_implicit_layer_path="$fgvk_install_prefix/share/framegen-vulkan/vulkan/implicit_layer.d"
if [[ ! -d "$fgvk_implicit_layer_path" && -d "$fgvk_data_home/framegen-vulkan/vulkan/implicit_layer.d" ]]; then
    fgvk_implicit_layer_path="$fgvk_data_home/framegen-vulkan/vulkan/implicit_layer.d"
elif [[ ! -d "$fgvk_implicit_layer_path" ]]; then
    fgvk_implicit_layer_path="$fgvk_install_prefix/share/vulkan/implicit_layer.d"
fi

# When overlay removal is off, preserve Steam's named Desktop Mode FPS overlay
# when Steam requested it and its per-user manifests are available.
# The directory is exposed solely for explicit-layer discovery, so
# Steam Fossilize and unrelated implicit layers remain outside framegen-vulkan's boundary.
# Gaming Mode keeps its compositor-owned performance display unchanged.
fgvk_steam_overlay_layers=""
fgvk_steam_overlay_layer_dir="$fgvk_data_home/vulkan/implicit_layer.d"
fgvk_flatpak_launch=0
if [[ "${1##*/}" == flatpak && "${2:-}" == run ]]; then
    fgvk_flatpak_launch=1
fi
if [[ "$fgvk_disable_steam_overlay" != 1 &&
        "${ENABLE_VK_LAYER_VALVE_steam_overlay_1:-0}" == 1 &&
        "$fgvk_flatpak_launch" != 1 ]]; then
    if [[ -r "$fgvk_steam_overlay_layer_dir/steamoverlay_x86_64.json" ]]; then
        fgvk_steam_overlay_layers=VK_LAYER_VALVE_steam_overlay_64
    fi
    if [[ -r "$fgvk_steam_overlay_layer_dir/steamoverlay_i386.json" ]]; then
        fgvk_steam_overlay_layers="${fgvk_steam_overlay_layers:+$fgvk_steam_overlay_layers:}VK_LAYER_VALVE_steam_overlay_32"
    fi
    if [[ -n "$fgvk_steam_overlay_layers" ]]; then
        export VK_LAYER_PATH="$fgvk_steam_overlay_layer_dir${VK_LAYER_PATH:+:$VK_LAYER_PATH}"
    fi
fi

# Remove any inherited vkBasalt layer so a system-wide manifest or duplicate
# caller entry cannot put it in the chain. The exported DISABLE_VKBASALT=1 keeps
# any implicit vkBasalt manifest inactive.
fgvk_existing_instance_layers=":${VK_INSTANCE_LAYERS:-}:"
while [[ "$fgvk_existing_instance_layers" == *":VK_LAYER_VKBASALT_post_processing:"* ]]; do
    fgvk_existing_instance_layers="${fgvk_existing_instance_layers/:VK_LAYER_VKBASALT_post_processing:/:}"
done
for fgvk_mangohud_layer in VK_LAYER_MANGOHUD_overlay_x86_64 VK_LAYER_MANGOHUD_overlay_x86; do
    while [[ "$fgvk_existing_instance_layers" == *":$fgvk_mangohud_layer:"* ]]; do
        fgvk_existing_instance_layers="${fgvk_existing_instance_layers/:$fgvk_mangohud_layer:/:}"
    done
done
if [[ -n "$fgvk_steam_overlay_layers" ]]; then
    for fgvk_steam_overlay_layer in VK_LAYER_VALVE_steam_overlay_64 VK_LAYER_VALVE_steam_overlay_32; do
        while [[ "$fgvk_existing_instance_layers" == *":$fgvk_steam_overlay_layer:"* ]]; do
            fgvk_existing_instance_layers="${fgvk_existing_instance_layers/:$fgvk_steam_overlay_layer:/:}"
        done
    done
fi
fgvk_existing_instance_layers="${fgvk_existing_instance_layers#:}"
fgvk_existing_instance_layers="${fgvk_existing_instance_layers%:}"

if [[ -n "$fgvk_steam_overlay_layers" && "${DISABLE_FGVK:-0}" != 1 ]]; then
    if [[ -n "$fgvk_existing_instance_layers" ]]; then
        export VK_INSTANCE_LAYERS="VK_LAYER_FGVK_render:$fgvk_steam_overlay_layers:$fgvk_existing_instance_layers"
    else
        export VK_INSTANCE_LAYERS="VK_LAYER_FGVK_render:$fgvk_steam_overlay_layers"
    fi
elif [[ -n "$fgvk_steam_overlay_layers" ]]; then
    if [[ -n "$fgvk_existing_instance_layers" ]]; then
        export VK_INSTANCE_LAYERS="$fgvk_steam_overlay_layers:$fgvk_existing_instance_layers"
    else
        export VK_INSTANCE_LAYERS="$fgvk_steam_overlay_layers"
    fi
else
    unset VKBASALT_CONFIG_RELOAD
    if [[ -n "$fgvk_existing_instance_layers" ]]; then
        export VK_INSTANCE_LAYERS="$fgvk_existing_instance_layers"
    else
        unset VK_INSTANCE_LAYERS
    fi
fi
if [[ "$fgvk_mangohud_requested" == 1 && "${DISABLE_FGVK:-0}" != 1 ]]; then
    if [[ -n "${FLATPAK_ID:-}" || "$fgvk_flatpak_launch" == 1 ]]; then
        echo "framegen-vulkan: host MangoHud is unavailable for Flatpak; continuing without MangoHud." >&2
    elif fgvk_mangohud_directory="$(fgvk_mangohud_manifests)"; then
        fgvk_implicit_layer_path="$fgvk_implicit_layer_path:$fgvk_mangohud_directory"
        export MANGOHUD=1
        unset DISABLE_MANGOHUD
        # Keep the 64-bit manifest explicit. The guarded 32-bit manifest
        # stays implicit and is admitted only to a matching 32-bit process.
        # MangoHud goes above framegen-vulkan (first in the list, nearest the
        # application): below it, MangoHud draws on every lower present
        # inside the private queue lock, which lengthened the game's queued
        # acquires and delayed each output by ~1.3 ms on a busy GPU.
        if [[ -r "$fgvk_mangohud_directory/MangoHud.x86_64.json" ]]; then
            fgvk_mangohud_chain=":${VK_INSTANCE_LAYERS:-}:"
            while [[ "$fgvk_mangohud_chain" == *":VK_LAYER_FGVK_render:"* ]]; do
                fgvk_mangohud_chain="${fgvk_mangohud_chain/:VK_LAYER_FGVK_render:/:}"
            done
            fgvk_mangohud_chain="${fgvk_mangohud_chain#:}"
            fgvk_mangohud_chain="${fgvk_mangohud_chain%:}"
            export VK_INSTANCE_LAYERS="VK_LAYER_MANGOHUD_overlay_x86_64:VK_LAYER_FGVK_render${fgvk_mangohud_chain:+:$fgvk_mangohud_chain}"
        fi
    else
        echo "framegen-vulkan: continuing without MangoHud." >&2
    fi
fi
unset fgvk_mangohud_requested fgvk_mangohud_directory
unset fgvk_mangohud_chain fgvk_mangohud_layer
export VK_IMPLICIT_LAYER_PATH="$fgvk_implicit_layer_path"
unset VK_ADD_IMPLICIT_LAYER_PATH
# Apply the saved process-start Performance setting before application exec.
# BEGIN FGVK_STEAM_OVERLAY_PRELOAD_POLICY
fgvk_steam_overlay_preload_removed=0
fgvk_steam_overlay_preload_filter_requested="${fgvk_disable_steam_overlay:-1}"
if [[ "$fgvk_steam_overlay_preload_filter_requested" == 1 ]]; then
    export DISABLE_VK_LAYER_VALVE_steam_overlay_1=1
    unset ENABLE_VK_LAYER_VALVE_steam_overlay_1
    fgvk_overlay_instance_layers=":${VK_INSTANCE_LAYERS:-}:"
    for fgvk_overlay_layer in VK_LAYER_VALVE_steam_overlay_64 VK_LAYER_VALVE_steam_overlay_32; do
        while [[ "$fgvk_overlay_instance_layers" == *":$fgvk_overlay_layer:"* ]]; do
            fgvk_overlay_instance_layers="${fgvk_overlay_instance_layers/:$fgvk_overlay_layer:/:}"
        done
    done
    fgvk_overlay_instance_layers="${fgvk_overlay_instance_layers#:}"
    fgvk_overlay_instance_layers="${fgvk_overlay_instance_layers%:}"
    if [[ -n "$fgvk_overlay_instance_layers" ]]; then
        export VK_INSTANCE_LAYERS="$fgvk_overlay_instance_layers"
    else
        unset VK_INSTANCE_LAYERS
    fi
    fgvk_preload_list="${LD_PRELOAD:-}"
    fgvk_preload_list="${fgvk_preload_list//[$' \t\n\r\v\f:']/ }"
    IFS=' ' read -r -a fgvk_preload_entries <<< "$fgvk_preload_list"
    fgvk_retained_preloads=""
    for fgvk_preload_entry in "${fgvk_preload_entries[@]}"; do
        if [[ "${fgvk_preload_entry##*/}" == gameoverlayrenderer.so ]]; then
            fgvk_steam_overlay_preload_removed=$((fgvk_steam_overlay_preload_removed + 1))
        else
            fgvk_retained_preloads="${fgvk_retained_preloads:+$fgvk_retained_preloads:}$fgvk_preload_entry"
        fi
    done
    if ((fgvk_steam_overlay_preload_removed > 0)); then
        if [[ -n "$fgvk_retained_preloads" ]]; then
            export LD_PRELOAD="$fgvk_retained_preloads"
        else
            unset LD_PRELOAD
        fi
    fi
    unset fgvk_overlay_instance_layers fgvk_overlay_layer
    unset fgvk_preload_list fgvk_preload_entries fgvk_preload_entry fgvk_retained_preloads
fi
# END FGVK_STEAM_OVERLAY_PRELOAD_POLICY
unset fgvk_steam_overlay_preload_removed
unset fgvk_steam_overlay_preload_filter_requested fgvk_disable_steam_overlay
unset fgvk_launcher_dir fgvk_data_home fgvk_implicit_layer_path
unset fgvk_existing_instance_layers
unset fgvk_steam_overlay_layer_dir fgvk_steam_overlay_layer
unset fgvk_steam_overlay_layers fgvk_flatpak_launch

# The game's own DXVK_HDR passes through: HDR swapchains get frame generation (H1).
if [[ -n "${VK_INSTANCE_LAYERS:-}" &&
        ":${VK_INSTANCE_LAYERS}:" == *":VK_LAYER_FGVK_render:"* ]]; then
    unset ENABLE_FGVK
else
    export ENABLE_FGVK=1
fi

unset fgvk_install_prefix

exec "$@"
