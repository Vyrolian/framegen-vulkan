# pacman scriptlet for framegen-vulkan-bin.
#
# This package installs framegen-vulkan system-wide under /usr. The standalone
# archive installer manages an independent, user-local copy under ~/.local. This
# script never modifies user files: it only reports coexisting installs and
# prints usage guidance. It runs under /bin/sh and must always return 0.

fgvk_renderer_bin_user_homes() {
    # Candidate human homes. pacman usually runs as root, where HOME is /root,
    # so the invoking user's home is recovered from SUDO_USER and from /home.
    {
        if [ -n "${HOME:-}" ] && [ -d "${HOME}" ]; then
            printf '%s\n' "${HOME}"
        fi

        if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
            fgvk_renderer_bin_sudo_home="$(timeout 5 getent passwd "${SUDO_USER}" 2>/dev/null | cut -d: -f6)"
            if [ -n "${fgvk_renderer_bin_sudo_home}" ] && [ -d "${fgvk_renderer_bin_sudo_home}" ]; then
                printf '%s\n' "${fgvk_renderer_bin_sudo_home}"
            fi
        fi

        for fgvk_renderer_bin_dir in /home/*; do
            if [ -d "${fgvk_renderer_bin_dir}" ]; then
                printf '%s\n' "${fgvk_renderer_bin_dir}"
            fi
        done
    } | sort -u

    return 0
}

fgvk_renderer_bin_user_local_owner() {
    fgvk_renderer_bin_home="${1:-}"
    [ -n "${fgvk_renderer_bin_home}" ] || return 1

    if [ -f "${fgvk_renderer_bin_home}/.local/share/framegen-vulkan/active-renderer.json" ] \
        || [ -f "${fgvk_renderer_bin_home}/.local/share/framegen-vulkan/lib/libfgvk-render.so" ] \
        || [ -f "${fgvk_renderer_bin_home}/.local/share/framegen-vulkan/lib32/libfgvk-render.so" ] \
        || [ -f "${fgvk_renderer_bin_home}/.local/lib/libfgvk-render.so" ] \
        || [ -f "${fgvk_renderer_bin_home}/.local/lib32/libfgvk-render.so" ] \
        || [ -f "${fgvk_renderer_bin_home}/.local/libexec/framegen-vulkan/fgvk-launch" ] \
        || [ -f "${fgvk_renderer_bin_home}/.local/share/vulkan/implicit_layer.d/VkLayer_FGVK_render.json" ]; then
        fgvk_renderer_bin_owner="$(sed -n 's/.*"owner"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "${fgvk_renderer_bin_home}/.local/share/framegen-vulkan/active-renderer.json" 2>/dev/null | head -n 1)"
        # The value is read from a file the invoking user can write and is then
        # printed to the administrator's terminal, so accept only known owners
        # and otherwise print a fixed label. This also blocks terminal-escape
        # injection through the state file.
        case "${fgvk_renderer_bin_owner}" in
            standalone) ;;
            *) fgvk_renderer_bin_owner="unknown" ;;
        esac
        printf '%s\n' "${fgvk_renderer_bin_owner}"
        return 0
    fi

    return 1
}

fgvk_renderer_bin_report_coexistence() {
    fgvk_renderer_bin_found=0
    fgvk_renderer_bin_owner=""
    fgvk_renderer_bin_home=""
    # The home list is newline separated, and command substitution splits on
    # IFS, so restrict IFS to newline for the loop and restore it afterwards.
    # The loop must stay in this shell so fgvk_renderer_bin_found reaches the
    # caller.
    fgvk_renderer_bin_ifs_saved="${IFS}"
    IFS='
'
    for fgvk_renderer_bin_home in $(fgvk_renderer_bin_user_homes); do
        [ -n "${fgvk_renderer_bin_home}" ] || continue
        fgvk_renderer_bin_owner="$(fgvk_renderer_bin_user_local_owner "${fgvk_renderer_bin_home}")" || continue
        fgvk_renderer_bin_found=1
        printf '  - %s (owner: %s)\n' "${fgvk_renderer_bin_home}" "${fgvk_renderer_bin_owner}"
    done
    IFS="${fgvk_renderer_bin_ifs_saved}"

    return 0
}

fgvk_renderer_bin_coexistence_notice() {
    cat <<'EOF'
A user-local framegen-vulkan installation was found. This package installs framegen-vulkan
system-wide under /usr; it does not adopt, upgrade, or delete the user-local
copy. Both can coexist on disk, and fgvk selects its own private manifest
directory through VK_IMPLICIT_LAYER_PATH, so a managed launch does not load both
layer copies.

Pick one owner per user: either keep this system package and stop using the
user-local install, or remove this package and keep the user-local install.
Nothing is deleted automatically.
EOF
    return 0
}

fgvk_renderer_bin_guidance() {
    cat <<'EOF'
Create a profile in ~/.config/framegen-vulkan/conf.toml before launching a game;
installing the package does not activate framegen-vulkan for any game. Check it with
fgvk-cli validate.

For a native or Proton game, set this Steam launch option:
  /usr/bin/fgvk %command%
Use the absolute path: if you put ~/.local/bin ahead of /usr/bin in PATH, a
user-local fgvk would otherwise shadow the packaged one.

Frame generation needs a user-owned Lossless.dll from
Lossless Scaling. DirectX LSFG models
additionally need vkd3d (lib32-vkd3d for 32-bit games). Both are optional dependencies.

Do not run upstream's fgvk-installer: it targets ~/.local and would create a
second, independently managed copy. Remove the package with pacman instead.
EOF
    return 0
}

pre_install() {
    printf '==> framegen-vulkan-bin: checking for user-local framegen-vulkan installs\n'
    fgvk_renderer_bin_report_coexistence
    if [ "${fgvk_renderer_bin_found:-0}" = "1" ]; then
        fgvk_renderer_bin_coexistence_notice
    fi
    return 0
}

post_install() {
    fgvk_renderer_bin_guidance
    return 0
}

pre_upgrade() {
    printf '==> framegen-vulkan-bin: checking for user-local framegen-vulkan installs\n'
    fgvk_renderer_bin_report_coexistence
    if [ "${fgvk_renderer_bin_found:-0}" = "1" ]; then
        fgvk_renderer_bin_coexistence_notice
    fi
    return 0
}

post_upgrade() {
    fgvk_renderer_bin_guidance
    return 0
}

pre_remove() {
    printf '==> framegen-vulkan-bin: pacman removes only package-owned files under /usr\n'
    printf 'Profiles, settings, and diagnostics in ~/.config/framegen-vulkan are preserved;\n'
    printf 'remove them manually if you no longer want them. Any user-local framegen-vulkan\n'
    printf 'Renderer installation is left untouched.\n'
    fgvk_renderer_bin_report_coexistence
    if [ "${fgvk_renderer_bin_found:-0}" = "1" ]; then
        printf 'The user-local installation listed above remains in place and stays usable.\n'
    fi
    return 0
}

post_remove() {
    printf '==> framegen-vulkan-bin: user data was not removed\n'
    printf 'Profiles, settings, and diagnostics in ~/.config/framegen-vulkan are preserved;\n'
    printf 'remove them manually if you no longer want them. Any user-local framegen-vulkan\n'
    printf 'Renderer installation is left untouched.\n'
    return 0
}
