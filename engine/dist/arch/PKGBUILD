# Maintainer: xidongbot <xidong-ai@foxmail.com>
# Upstream: https://github.com/eugeniosegala/MAKO
#
# This PKGBUILD repackages the official prebuilt framegen-vulkan host archive
# (framegen-vulkan-vX.Y.Z-linux.tar.xz) into a system-wide pacman package.
# It does not build framegen-vulkan from source. The upstream ELF binaries and shared
# libraries are installed byte-identical to the release archive so they stay
# verifiable against framegen-vulkan-install-manifest.txt.
#
# Run check-release-pin.sh next to this file to confirm that pkgver, source
# and sha256sums still match the release pinned in engine/renderer-release.json.

pkgname=framegen-vulkan-bin
pkgver=4.6.0
pkgrel=1
pkgdesc="Frame generation Vulkan layer for Linux games"
arch=('x86_64')
url="https://github.com/eugeniosegala/MAKO"
license=('GPL-3.0-or-later')
install="${pkgname}.install"

# Runtime dependencies mapped to the DT_NEEDED entries of the shipped binaries.
# Both layer sets ship 64-bit and 32-bit libraries, hence the lib32 entries.
# bash is intentionally not listed even though /usr/libexec/framegen-vulkan/fgvk-launch is a
# bash script: bash is guaranteed by base.
depends=(
    # libc.so.6, libm.so.6, ld-linux-x86-64.so.2
    'glibc'
    # libstdc++.so.6, libgcc_s.so.1
    'gcc-libs'
    # libGLX.so.0, libOpenGL.so.0
    'libglvnd'
    # libX11.so.6, dlopened by the settings window's X11 backend
    'libx11'
    # The Vulkan loader dlopens the layers. It is not a DT_NEEDED entry, but the
    # implicit layers are unusable without it.
    'vulkan-icd-loader'
    # 32-bit libc.so.6, libm.so.6, ld-linux.so.2
    'lib32-glibc'
    # 32-bit libstdc++.so.6, libgcc_s.so.1
    'lib32-gcc-libs'
    # 32-bit Vulkan loader for the lib32 layers
    'lib32-vulkan-icd-loader'
)

optdepends=(
    'vkd3d: DirectX LSFG models need libvkd3d-shader.so.1 (64-bit)'
    'lib32-vkd3d: DirectX LSFG models need libvkd3d-shader.so.1 (32-bit)'
    'lib32-mesa: Zink support for 32-bit OpenGL games'
)

# Upstream binaries are already stripped and must remain byte-identical to the
# official archive so they can be checked against
# framegen-vulkan-install-manifest.txt. Do not strip them or generate debug symbols.
options=('!strip' '!debug')

# Treat a future source-built fgvk-renderer package as the interchangeable
# implementation. Pacman then resolves dependencies against either package and
# removes one before installing the other instead of relying on a late file
# conflict.
provides=("fgvk-renderer=${pkgver}")
conflicts=('fgvk-renderer')

source=("framegen-vulkan-v${pkgver}-linux.tar.xz::https://github.com/eugeniosegala/MAKO/releases/download/render-v${pkgver}/MAKO-Renderer-v${pkgver}-linux.tar.xz")
sha256sums=('66224414e2d94f7cb019226735b3b6d26b9be7103c5334250522f7260213be56')
noextract=("framegen-vulkan-v${pkgver}-linux.tar.xz")

_fgvk_install_payload_file() {
    local relative_path="$1"
    local destination_path=""
    local install_mode=644

    case "$relative_path" in
        "" | /* | ../* | */../* | */.. | ./* | */./* | */.)
            printf 'framegen-vulkan-bin: unsafe archive manifest path: %s\n' "$relative_path" >&2
            return 1
            ;;
    esac
    if [[ ! -f "$relative_path" ]]; then
        printf 'framegen-vulkan-bin: archive manifest path is missing: %s\n' "$relative_path" >&2
        return 1
    fi

    case "$relative_path" in
        bin/fgvk-installer | bin/*-ui | share/applications/*)
            # The user-local installer must never manage a pacman-owned system
            # prefix. The Renderer-only package ships no configuration app or
            # desktop entries, including those in older archives.
            return 0
            ;;
        share/doc/framegen-vulkan/LICENSE | share/doc/framegen-vulkan/COPYRIGHT.md | share/doc/framegen-vulkan/THIRD_PARTY_NOTICES.md)
            destination_path="$pkgdir/usr/share/licenses/$pkgname/${relative_path##*/}"
            ;;
        share/doc/framegen-vulkan/*)
            destination_path="$pkgdir/usr/share/doc/$pkgname/${relative_path#share/doc/framegen-vulkan/}"
            ;;
        bin/*)
            destination_path="$pkgdir/usr/$relative_path"
            install_mode=755
            ;;
        lib/* | lib32/* | libexec/*)
            destination_path="$pkgdir/usr/$relative_path"
            install_mode=755
            ;;
        share/*)
            destination_path="$pkgdir/usr/$relative_path"
            ;;
        *)
            printf 'framegen-vulkan-bin: unsupported archive manifest path: %s\n' "$relative_path" >&2
            return 1
            ;;
    esac

    install -Dm"$install_mode" "$relative_path" "$destination_path"
}

prepare() {
    # The archive is noextract so its root files never leak into srcdir. Recreate
    # and verify one private payload copy outside fakeroot on every preparation.
    rm -rf payload
    mkdir -p payload
    tar -xJf "$srcdir/framegen-vulkan-v${pkgver}-linux.tar.xz" -C payload
    cd "$srcdir/payload"

    if ! sha256sum --check --status framegen-vulkan-install-manifest.txt; then
        printf '%s\n' 'framegen-vulkan-bin: archive payload does not match its install manifest' >&2
        return 1
    fi
}

package() {
    cd "$srcdir/payload"

    local required_path
    local required_paths=(
        bin/fgvk-cli
        bin/fgvk-installer
        bin/fgvk
        libexec/framegen-vulkan/fgvk-launch
        lib/libfgvk-render.so
        lib32/libfgvk-render.so
        share/doc/framegen-vulkan/ASSET_PROVENANCE.md
        share/doc/framegen-vulkan/COPYRIGHT.md
        share/doc/framegen-vulkan/LICENSE
        share/doc/framegen-vulkan/THIRD_PARTY_NOTICES.md
        share/framegen-vulkan/vulkan/implicit_layer.d/VkLayer_FGVK_render.json
        share/framegen-vulkan/vulkan/implicit_layer.d/VkLayer_FGVK_render.x86.json
        share/vulkan/implicit_layer.d/VkLayer_FGVK_render.json
        share/vulkan/implicit_layer.d/VkLayer_FGVK_render.x86.json
    )
    for required_path in "${required_paths[@]}"; do
        if [[ ! -f "$required_path" ]]; then
            printf 'framegen-vulkan-bin: required archive payload is missing: %s\n' "$required_path" >&2
            return 1
        fi
    done

    local manifest_line manifest_checksum manifest_path
    while IFS= read -r manifest_line || [[ -n "$manifest_line" ]]; do
        manifest_checksum="${manifest_line%%  *}"
        manifest_path="${manifest_line#*  }"
        if [[ ! "$manifest_checksum" =~ ^[0-9a-f]{64}$ || "$manifest_path" == "$manifest_line" ]]; then
            printf 'framegen-vulkan-bin: invalid archive manifest entry: %s\n' "$manifest_line" >&2
            return 1
        fi
        _fgvk_install_payload_file "$manifest_path"
    done < framegen-vulkan-install-manifest.txt

    # Version and the upstream checksum manifest are outside the installer's
    # managed payload but remain available for package provenance audits.
    install -Dm644 framegen-vulkan-version.txt "$pkgdir/usr/share/doc/framegen-vulkan-bin/framegen-vulkan-version.txt"
    install -Dm644 framegen-vulkan-install-manifest.txt "$pkgdir/usr/share/doc/framegen-vulkan-bin/framegen-vulkan-install-manifest.txt"

    # Deliberately not installed:
    # - bin/fgvk-installer: the user-local installer, which targets ~/.local and
    #   manages its own renderer copy.
    # - bin/*-ui and share/applications/*: the Qt configuration app and desktop
    #   entries were removed from the Renderer, and this package does not ship
    #   them even when an older archive contains them.
    # - README.txt from the archive root: it documents the user-local installer
    #   flow that this package deliberately does not provide.
}
