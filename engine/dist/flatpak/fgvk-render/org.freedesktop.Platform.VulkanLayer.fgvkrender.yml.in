id: org.freedesktop.Platform.VulkanLayer.fgvkrender
default-branch: develop

runtime: org.freedesktop.Platform
runtime-version: '@RUNTIME_VERSION@'
sdk: org.freedesktop.Sdk
branch: '@RUNTIME_VERSION@'
build-extension: true

sdk-extensions:
  - org.freedesktop.Sdk.Extension.llvm@LLVM_VERSION@
  - org.freedesktop.Sdk.Compat.i386
  - org.freedesktop.Sdk.Extension.toolchain-i386

build-options:
  cxxflags: -I/usr/lib/extensions/vulkan/fgvkrender/include
  prefix: /usr/lib/extensions/vulkan/fgvkrender
  append-path: /usr/lib/sdk/llvm@LLVM_VERSION@/bin
  prepend-ld-library-path: /usr/lib/sdk/llvm@LLVM_VERSION@/lib

modules:
  - vulkan-headers.json
  - vkbasalt-module.json
  - name: fgvk
    buildsystem: cmake-ninja
    subdir: engine
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON
      - -DCMAKE_CXX_COMPILER=clang++
      - -DCMAKE_INSTALL_LIBDIR=lib64
      - -DBUILD_TESTING=OFF
      - -DFGVK_REQUIRE_NATIVE_PACKAGE_HEADERS=ON
      - -DFGVK_BUILD_VK_LAYER=ON
      - -DFGVK_BUILD_CLI=OFF
      - -DFGVK_LAYER_LIBRARY_PATH=/usr/lib/extensions/vulkan/fgvkrender/lib64/libfgvk-render.so
      - -DFGVK_SCALING_LAYER_LIBRARY_PATH=/usr/lib/extensions/vulkan/fgvkrender/lib64/libfgvk-render-scaling.so
    sources:
      - type: dir
        path: ../../../..
        skip:
          - engine/build

  - name: fgvk-32bit
    buildsystem: cmake-ninja
    subdir: engine
    build-options:
      append-path: /usr/lib/sdk/toolchain-i386/bin
      env:
        CC: i686-unknown-linux-gnu-gcc
        CXX: i686-unknown-linux-gnu-g++
    config-opts:
      - -DCMAKE_BUILD_TYPE=Release
      - -DCMAKE_CXX_COMPILER=i686-unknown-linux-gnu-g++
      - -DCMAKE_INSTALL_LIBDIR=lib/i386-linux-gnu
      - -DBUILD_TESTING=OFF
      - -DFGVK_REQUIRE_NATIVE_PACKAGE_HEADERS=ON
      - -DFGVK_BUILD_VK_LAYER=ON
      - -DFGVK_BUILD_CLI=OFF
      - -DFGVK_LAYER_MANIFEST_SUFFIX=.x86
      - -DFGVK_LAYER_LIBRARY_PATH=/usr/lib/extensions/vulkan/fgvkrender/lib/i386-linux-gnu/libfgvk-render.so
      - -DFGVK_SCALING_LAYER_LIBRARY_PATH=/usr/lib/extensions/vulkan/fgvkrender/lib/i386-linux-gnu/libfgvk-render-scaling.so
    sources:
      - type: dir
        path: ../../../..
        skip:
          - engine/build
