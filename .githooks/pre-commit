#!/usr/bin/env bash
set -euo pipefail

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

./scripts/check-protected-inputs.sh

if ! command -v npm >/dev/null 2>&1; then
  printf '%s\n' 'MAKO pre-commit: npm is required to format staged Markdown.' >&2
  exit 1
fi

if [[ ! -x node_modules/.bin/lint-staged ]]; then
  printf '%s\n' 'MAKO pre-commit: install repository tools with `npm ci`.' >&2
  exit 1
fi

npm run format:staged
